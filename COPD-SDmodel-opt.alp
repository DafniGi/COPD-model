					<Action><![CDATA[// Record (note: indices are a little funky for dimensions)
for(int age = 1; age <= Age_Group.size(); age++) {
	double totalMild = mild_exacerbations.get(age);
	double totalModerate = moderate_exacerbations.get(age);
	double totalSevere = severe_exacerbations.get(age);
	double totalExacerbations = totalMild + totalModerate + totalSevere;

	//listYearlyExacerbations.get(age-1).add(totalExacerbations);
	listYearlyExacerbations.get(age-1).add(totalSevere);
}
// Reset stock
mild_exacerbations.set(0.0);
moderate_exacerbations.set(0.0);
severe_exacerbations.set(0.0);]]></Action>
