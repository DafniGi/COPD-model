						<EnableExpression><![CDATA[getBestIteration() > 0]]></EnableExpression>
						<ActionCode><![CDATA[String s = "";
s += "no_mild_COPD_Rate\t" + format( no_mild_COPD_Rate ) + "\n";
s += "mild_moderate_COPD_Rate\t" + format( mild_moderate_COPD_Rate ) + "\n";
s += "moderate_severe_COPD_Rate\t" + format( moderate_severe_COPD_Rate ) + "\n";
s += "severe_VERYsevere_COPD_Rate\t" + format( severe_VERYsevere_COPD_Rate ) + "\n";
s += "un_diagnosed_mild_COPD_Rate\t" + format( un_diagnosed_mild_COPD_Rate ) + "\n";
s += "un_diagnosed_moderate_COPD_Rate\t" + format( un_diagnosed_moderate_COPD_Rate ) + "\n";
s += "diagnosed_mild_moderate_COPD_Rate\t" + format( diagnosed_mild_moderate_COPD_Rate ) + "\n";
s += "diagnosed_moderate_severe_COPD_Rate\t" + format( diagnosed_moderate_severe_COPD_Rate ) + "\n";
s += "diagnosed_severe_VERYsevere_COPD_Rate\t" + format( diagnosed_severe_VERYsevere_COPD_Rate ) + "\n";
s += "un_diagnosed_severe_COPD_Rate\t" + format( un_diagnosed_severe_COPD_Rate ) + "\n";
s += "un_diagnosed_VERYsevere_COPD_Rate\t" + format( un_diagnosed_VERYsevere_COPD_Rate ) + "\n";
s += "mild_COPD_exacerbation_Rate\t" + format( mild_COPD_exacerbation_Rate ) + "\n";
s += "moderate_COPD_exacerbation_Rate\t" + format( moderate_COPD_exacerbation_Rate ) + "\n";
s += "severe_COPD_exacerbation_Rate\t" + format( severe_COPD_exacerbation_Rate ) + "\n";
s += "VERYsevere_COPD_exacerbation_Rate\t" + format( VERYsevere_COPD_exacerbation_Rate ) + "\n";

copyToClipboard( s );]]></ActionCode>
