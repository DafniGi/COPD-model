		<!--   =========  Optimization Experiment   ========  -->
		<OptimizationExperiment ActiveObjectClassId="1788904641147">
			<Id>1793910983989</Id>
			<Name><![CDATA[Optimization]]></Name>
			<AdditionalClassCode><![CDATA[double currentIterationObjective = 0.0;
ArrayList<ArrayList<Double>> exacerbationCounts = new ArrayList<ArrayList<Double>>();]]></AdditionalClassCode>
			<Import><![CDATA[import java.io.BufferedReader;
import java.io.FileReader;
import java.io.IOException;
import java.util.ArrayList;]]></Import>
			<CommandLineArguments><![CDATA[]]></CommandLineArguments>
			<InitialSetupCode><![CDATA[// File structure: Year | Age Group | Count
// There must be a row for each age group for each date, such
// that the dimensions of 'exacerbationCounts' exactly match
// those of 'listYearlyExacerbations'.
// "C:/Users/Jalen/Models/2026_COPD/COPD-SDmodel1/yearlySynthCOPD.tsv"
String file = "C:/Users/dglit/Documents/AI4PH Internship/yearlySynthCOPD.tsv";

String[] args = this.getCommandLineArguments();
for(int i = 0; i < args.length; i++){
	if((i%2)==0){
		switch(args[i]){
			case "-f":
				file = args[i+1];
				break;	
		}
	}
}

traceln(file);

String line = "";
String splitBy = "\t";

int countAgeGroups = 7;
int currentAgeGroup = 0;
for (int i = 0; i < countAgeGroups; i ++) {
	exacerbationCounts.add(new ArrayList<Double>());
}

try (BufferedReader br = new BufferedReader(new FileReader(file))) {
    br.readLine(); // Skip header.

    while ((line = br.readLine()) != null) {
        String[] row = line.split(splitBy);
        exacerbationCounts.get(currentAgeGroup).add(Double.parseDouble(row[2].trim()));
        
        if (currentAgeGroup < countAgeGroups-1) {
        	currentAgeGroup ++;
        } else {
        	currentAgeGroup = 0;
        }
    }
} catch (IOException e) {
    e.printStackTrace();
}

traceln(exacerbationCounts);]]></InitialSetupCode>
			<MaximumMemory>4096</MaximumMemory>
			<RandomNumberGenerationType>randomSeed</RandomNumberGenerationType>
			<CustomGeneratorCode>new Random()</CustomGeneratorCode>
			<BeforeEachExperimentRunCode><![CDATA[datasetCurrentObjective.reset();
datasetBestInfeasibleObjective.reset();
datasetBestFeasibleObjective.reset();]]></BeforeEachExperimentRunCode>
			<AfterSimulationRunCode><![CDATA[double rootSquaredErrorSum = 0.0;

for (int i = 0; i < root.listYearlyExacerbations.size(); i++) {
	for (int j = 0; j < root.listYearlyExacerbations.get(i).size(); j++) {
	
    	double historicalValue = exacerbationCounts.get(i).get(j);
    	double simulatedValue = root.listYearlyExacerbations.get(i).get(j);
    
    	double error = historicalValue - simulatedValue;
    	rootSquaredErrorSum += sqrt(error * error);
    }
}

currentIterationObjective = rootSquaredErrorSum;]]></AfterSimulationRunCode>
